rules_version = '2';

// Pegar en Firebase → Firestore Database → Reglas → Publicar.
// Todo el mundo puede leer; solo el administrador (su UID) puede escribir.
service cloud.firestore {
  match /databases/{database}/documents {
    function esAdmin() {
      return request.auth != null && request.auth.uid == 'NQzuTsUzs4fYw1D7gTHfItPvxVf1';
    }

    match /{coleccion}/{id} {
      allow read: if coleccion in ['personajes', 'categorias', 'equipos', 'formaciones'];
      allow write: if esAdmin();
    }
  }
}
